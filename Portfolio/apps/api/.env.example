# ==============================================================================
# NOVA FastAPI Backend Environment Variables
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME=NOVA
OWNER_NAME=Disha
GITHUB_USERNAME=dish3

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nova
DATABASE_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/nova

# Supabase Credentials (Backend Secrets)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# Security & Admin Secrets
INTERNAL_POLL_SECRET=change_me_in_production_shared_secret
ADMIN_API_KEY=change_me_in_production_admin_key
JWT_SECRET=change_me_in_production_jwt_secret
REVALIDATION_SECRET=change_me_in_production_revalidation_secret
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
