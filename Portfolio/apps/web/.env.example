# Next.js Frontend Environment Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_NAME=NOVA OS

# Optional Supabase client-side config (read-only with RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ISR Revalidation Secret (Matches backend REVALIDATION_SECRET)
REVALIDATION_SECRET=change_me_in_production_revalidation_secret

# Admin Session Secret (Skeleton auth)
ADMIN_SESSION_SECRET=change_me_in_production_session_secret
