# ==============================================================================
# NOVA AI Portfolio OS — Master Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development. NEVER commit .env to source control.
# Variables are grouped by domain and execution tier (Backend-only vs Frontend-safe).

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # 'development' | 'preview' | 'production'
LOG_LEVEL=INFO                         # 'DEBUG' | 'INFO' | 'WARNING' | 'ERROR'
PROJECT_NAME=NOVA
OWNER_NAME=Disha

# ------------------------------------------------------------------------------
# 2. DATABASE & SUPABASE (Backend Secrets — NEVER expose to browser)
# ------------------------------------------------------------------------------
# PostgreSQL connection string with pgvector extension enabled.
# For Supabase: use pooler connection for app, direct connection for migrations.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase Project Credentials
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY is safe for client-side reads if RLS is configured.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS. BACKEND ONLY! NEVER EXPOSE TO WEB.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. AI SERVICES (Gemini API — Backend Only)
# ------------------------------------------------------------------------------
# Free tier key from Google AI Studio. NEVER expose to web client.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash           # Default model for summaries & generation
GEMINI_FAST_MODEL=gemini-2.5-flash-lite # Fast classification model
GEMINI_EMBEDDING_MODEL=text-embedding-004 # 768-dimension embeddings matching schema

# ------------------------------------------------------------------------------
# 4. INTERNAL AUTHENTICATION & SECURITY (Backend Only)
# ------------------------------------------------------------------------------
# Shared secret for GitHub Actions cron workflows hitting internal poll endpoints
INTERNAL_POLL_SECRET=generate_a_secure_random_string_here_32_chars_min

# Admin authentication key / JWT secret for admin dashboard API
ADMIN_API_KEY=generate_a_secure_admin_api_key_here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=generate_secure_argon2_or_bcrypt_hash
JWT_SECRET=generate_a_secure_jwt_secret_key_here

# Secret used by backend to trigger ISR on Next.js frontend (POST /api/revalidate)
REVALIDATION_SECRET=generate_a_secure_revalidation_token_here

# Backend CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-portfolio-domain.vercel.app

# ------------------------------------------------------------------------------
# 5. PLATFORM CONNECTORS (Backend Only)
# ------------------------------------------------------------------------------
# GitHub Integration (Phase 1)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_USERNAME=

# LeetCode Integration (Phase 6 — Public GraphQL, username only)
LEETCODE_USERNAME=

# Future Connectors (Optional / Extensible — Phase 7)
# Note: X / Twitter is permanently excluded from this system per specification.
KAGGLE_USERNAME=
DEVPOST_USERNAME=
MEDIUM_USERNAME=
HASHNODE_USERNAME=

# ------------------------------------------------------------------------------
# 6. FRONTEND CLIENT-SAFE VARIABLES (Prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SITE_NAME=NOVA OS
NEXT_PUBLIC_ENABLE_RECRUITER_MODE=true
